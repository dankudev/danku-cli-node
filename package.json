{
	"name": "@dankudev/cli",
	"version": "0.1.0",
	"description": "Danku Node CLI for generating and managing application boilerplate.",
	"type": "module",
	"bin": {
		"danku": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit",
		"dev": "tsx src/index.ts",
		"format": "oxfmt",
		"lint": "oxfmt --check && oxlint",
		"prepack": "pnpm run build",
		"prepublishOnly": "pnpm run lint && pnpm run check && pnpm run build"
	},
	"keywords": [
		"cli",
		"danku",
		"generator",
		"scaffold",
		"effect"
	],
	"author": "Danku",
	"license": "MIT",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@effect/cli": "^0.75.1",
		"@effect/platform": "^0.96.1",
		"@effect/platform-node": "^0.106.0",
		"effect": "^3.21.2"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"oxfmt": "^0.49.0",
		"oxlint": "^1.64.0",
		"tsdown": "^0.22.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
